# TARANG Environment Variables
# Copy this to .env and fill in values before running docker-compose

# ── Copernicus Marine (optional, add once account is created at marine.copernicus.eu) ──
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ── PostGIS ──
POSTGRES_USER=tarang
POSTGRES_PASSWORD=tarang_secret
POSTGRES_DB=tarang
DATABASE_URL=postgresql://tarang:tarang_secret@postgis:5432/tarang

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Demo Region (Bay of Bengal primary) ──
DEMO_BBOX_BOB=80,5,100,25
DEMO_BBOX_ARABIAN_SEA=55,5,75,25
DEMO_TIME_START=2026-08-01
DEMO_TIME_END=2026-08-08

# ── Backend ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# ── Frontend ──
VITE_API_BASE_URL=http://localhost/api
VITE_THREDDS_BASE_URL=http://localhost/thredds
