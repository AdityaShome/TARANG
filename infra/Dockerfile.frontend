# TARANG Frontend Dockerfile
# ─────────────────────────────────────────────────────────────────────────────
# Multi-stage build:
#   stage "deps"  → install node_modules
#   stage "dev"   → Vite dev server (used in docker-compose for development)
#   stage "build" → production Vite build
#   stage "prod"  → Nginx serving the built static files
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: deps ─────────────────────────────────────────────────────────────
FROM node:20-slim AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --frozen-lockfile

# ── Stage 2: dev (used by docker-compose frontend service) ────────────────────
FROM deps AS dev
WORKDIR /app
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# ── Stage 3: production build ─────────────────────────────────────────────────
FROM deps AS build
WORKDIR /app
COPY . .
RUN npm run build

# ── Stage 4: production serve ─────────────────────────────────────────────────
FROM nginx:1.27-alpine AS prod
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
