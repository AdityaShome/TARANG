<?xml version="1.0" encoding="UTF-8"?>
<!--
  TARANG THREDDS Catalog
  ─────────────────────────────────────────────────────────────────────────────
  This catalog exposes local NetCDF fixtures via all four THREDDS services:
    • OPeNDAP  → /thredds/dodsC/netcdf/<filename>
    • WMS      → /thredds/wms/netcdf/<filename>?SERVICE=WMS&...
    • WCS      → /thredds/wcs/netcdf/<filename>?SERVICE=WCS&...
    • NCSS     → /thredds/ncss/netcdf/<filename>?...

  Data files are mounted from host ./data/netcdf/ into the container at
  /usr/local/tomcat/content/thredds/public/netcdf/ (see docker-compose.yml).
  urlPath below MUST match that mount prefix ("netcdf/") and the actual
  filenames written by backend/app/ingest/generate_fixtures.py and
  backend/app/ingest/download_copernicus.py, and referenced by registry/*.yaml.
-->
<catalog name="TARANG Data Catalog"
         xmlns="http://www.unidata.ucar.edu/namespaces/thredds/InvCatalog/v1.0"
         xmlns:xlink="http://www.w3.org/1999/xlink"
         xmlns:netcdf="http://www.unidata.ucar.edu/namespaces/netcdf/ncml-2.2"
         version="1.0.1">

  <service name="all" serviceType="Compound" base="">
    <service name="odap"  serviceType="OPeNDAP"        base="/thredds/dodsC/"/>
    <service name="wcs"   serviceType="WCS"            base="/thredds/wcs/"/>
    <service name="wms"   serviceType="WMS"            base="/thredds/wms/"/>
    <service name="ncss"  serviceType="NetcdfSubset"   base="/thredds/ncss/"/>
    <service name="http"  serviceType="HTTPServer"     base="/thredds/fileServer/"/>
  </service>

  <!-- Maps the "netcdf/" URL prefix used by every urlPath below to where the files actually
       are on disk (see docker-compose.yml's ./data/netcdf mount for this thredds service).
       Without this, THREDDS has no way to resolve urlPath="netcdf/<file>" to a real file —
       every OPeNDAP/WMS/WCS/NCSS request 404'd with "FileNotFound" regardless of whether the
       file existed, because this mapping was simply never declared. -->
  <datasetRoot path="netcdf" location="/usr/local/tomcat/content/thredds/public/netcdf/"/>

  <!-- ── Local pre-fetched NetCDF fixtures ───────────────────────────────── -->
  <dataset name="TARANG Local Datasets" ID="local">

    <dataset name="HYCOM Bay of Bengal — Water Temperature" ID="netcdf/hycom_water_temp"
             urlPath="netcdf/hycom_water_temp.nc">
      <serviceName>all</serviceName>
      <dataType>Grid</dataType>
      <dataFormat>NetCDF</dataFormat>
      <documentation type="summary">
        Synthetic climatological Bay of Bengal water temperature fixture
        (lat: 5-25 N, lon: 80-100 E, depth: 0-4000 m). Variable: water_temp.
        Generated by backend/app/ingest/generate_fixtures.py. CF-1.8 compliant.
      </documentation>
    </dataset>

    <dataset name="HYCOM Bay of Bengal — Salinity" ID="netcdf/hycom_salinity"
             urlPath="netcdf/hycom_salinity.nc">
      <serviceName>all</serviceName>
      <dataType>Grid</dataType>
      <dataFormat>NetCDF</dataFormat>
      <documentation type="summary">
        Synthetic climatological Bay of Bengal salinity fixture
        (lat: 5-25 N, lon: 80-100 E, depth: 0-4000 m). Variable: salinity.
        Generated by backend/app/ingest/generate_fixtures.py. CF-1.8 compliant.
      </documentation>
    </dataset>

    <dataset name="Copernicus Marine — Water Temperature (LIVE)" ID="netcdf/copernicus_bob_temp"
             urlPath="netcdf/copernicus_bob_temp.nc">
      <serviceName>all</serviceName>
      <dataType>Grid</dataType>
      <dataFormat>NetCDF</dataFormat>
      <documentation type="summary">
        Live Copernicus Marine Service (cmems_mod_glo_phy_anfc_0.083deg_P1D-m)
        potential temperature subset for Bay of Bengal. Variable: thetao.
        Fetched by backend/app/ingest/download_copernicus.py. CF-1.8 compliant.
      </documentation>
    </dataset>

    <dataset name="Copernicus Marine — Salinity (LIVE)" ID="netcdf/copernicus_bob_salinity"
             urlPath="netcdf/copernicus_bob_salinity.nc">
      <serviceName>all</serviceName>
      <dataType>Grid</dataType>
      <dataFormat>NetCDF</dataFormat>
      <documentation type="summary">
        Live Copernicus Marine Service (cmems_mod_glo_phy_anfc_0.083deg_P1D-m)
        salinity subset for Bay of Bengal. Variable: so.
        Fetched by backend/app/ingest/download_copernicus.py. CF-1.8 compliant.
      </documentation>
    </dataset>

  </dataset>

</catalog>
